{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^kbkdonationsystem-.*-kbk-donation-system\\.vercel\\.app$"
        }
      ],
      "destination": "https://kbkdonationsystem.vercel.app/:path*",
      "permanent": false
    }
  ]
}
